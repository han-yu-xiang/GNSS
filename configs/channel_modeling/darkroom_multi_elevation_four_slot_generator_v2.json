{
  "generator_id": "darkroom-multi-elevation-four-slot-generator-v2",
  "generator_version": "2.0.0",
  "sample_rate_hz": 10230000,
  "time_step_ms": 1,
  "path_parameter_block_ms": 40,
  "environments": [
    "Urban",
    "Special Reflective",
    "Mountain/Valley",
    "Highway/Open"
  ],
  "elevation_bands": ["LOW", "MID", "HIGH"],
  "satellite_id_by_band": {
    "LOW": "Low",
    "MID": "Mid",
    "HIGH": "High"
  },
  "final_columns": [
    "ms",
    "SatelliteID",
    "NLOSPathID",
    "RelativeDelay",
    "RelativeDoppler",
    "RelativeAmplitude",
    "RelativePhase_rad"
  ],
  "units": {
    "RelativeDelay": "ns",
    "RelativeDoppler": "Hz",
    "RelativeAmplitude": "linear_amplitude_ratio",
    "RelativePhase_rad": "rad"
  },
  "slot_policy": {
    "fixed_structural_slots_per_band": 4,
    "path0_slot_id": 0,
    "nlos_slot_ids": [1, 2, 3],
    "inactive_nlos_policy": "LATENT_PARAMETERS_WITH_ZERO_AMPLITUDE",
    "inactive_delay_doppler_phase_are_finite_latent_values": true,
    "inactive_values_are_physical_paths": false,
    "assumption_status": "LATENT_INACTIVE_PARAMETER_NOT_PHYSICAL_PATH"
  },
  "path_zero": {
    "RelativeDelay": 0.0,
    "RelativeDoppler": 0.0,
    "RelativeAmplitude_base": 1.0,
    "is_physical_los": false
  },
  "activation_mode_default": "EMPIRICAL_CONFIRMED_SUPPORT",
  "allowed_activation_modes": [
    "EMPIRICAL_CONFIRMED_SUPPORT",
    "CONDITIONAL_ACTIVE_STRESS"
  ],
  "lock_mapping_mode_default": "EMPIRICAL_DIAGNOSTIC_PROXY",
  "allowed_lock_mapping_modes": [
    "EMPIRICAL_DIAGNOSTIC_PROXY",
    "FORCED_LOCK_LOSS_STRESS"
  ],
  "phase_policy": {
    "initial_distribution": "Uniform(-pi,pi)",
    "recurrence": "phi_next=wrap_to_pi(phi+2*pi*relative_doppler_hz*0.001)",
    "wrap_interval": "[-pi,pi)",
    "phase_is_data_fitted": false,
    "inactive_phase_policy": "FINITE_LATENT_PHASE_CONTINUES_WITH_LATENT_DOPPLER",
    "lock_bad_resets_phase": false,
    "recovery_resets_phase": false,
    "assumption_status": "ASSUMPTION_ONLY_UNIFORM_INITIAL_PLUS_DOPPLER_CONTINUOUS"
  },
  "band_policy": {
    "band_order": ["LOW", "MID", "HIGH"],
    "satellite_id_order": ["Low", "Mid", "High"],
    "inter_satellite_correlation_modeled": false,
    "assumption_status": "INTER_SATELLITE_CORRELATION_NOT_MODELED"
  },
  "block_policy": {
    "base_delay_doppler_amplitude_fixed_per_block": true,
    "block_ms": 40,
    "activation_independent_between_blocks": true,
    "latent_slots_drawn_for_all_three_nlos_slots": true,
    "inter_block_path_identity_modeled": false,
    "assumption_status": "INDEPENDENT_40MS_BLOCK_ASSUMPTION"
  },
  "parent_generator_config": {
